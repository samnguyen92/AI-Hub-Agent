# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hub_ai_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hub_ai_agent

# LLM Gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=
DEFAULT_MODEL=openai/gpt-6-luna

# API Config
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Authentication and Telegram webhook (set unique random values before deployment)
AUTH_MODE=dev
AUTH_SECRET_KEY=replace_with_a_random_secret
ADMIN_API_TOKEN=replace_with_a_unique_admin_token
# Google OAuth (set credentials from Google Cloud Console; callback URL must match exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3000
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ADMIN_EMAILS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_webhook_secret_token

# Web Config
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
