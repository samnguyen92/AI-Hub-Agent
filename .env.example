# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hub_ai_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hub_ai_agent
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hub-workspaces
WORKSPACE_ARCHIVE_MAX_BYTES=41943040

# LLM Gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=openai/gpt-6-luna
DEFAULT_MODEL=openai/gpt-6-luna

# API Config
API_HOST=0.0.0.0
API_PORT=8000
SANDBOX_URL=http://sandbox:8001
SANDBOX_SHARED_SECRET=
WORKSPACES_ROOT=/workspaces
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3100,http://localhost:3000,https://hub.align.vn
WP_BASE_DOMAIN=demo.alignvn.cloud

# Authentication and Telegram webhook (set unique random values before deployment)
AUTH_MODE=dev
AUTH_SECRET_KEY=replace-with-a-stable-random-secret-at-least-32-characters
ADMIN_API_TOKEN=replace_with_a_unique_admin_token
# Google OAuth (set credentials from Google Cloud Console; callback URL must match exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3100
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ADMIN_EMAILS=
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD_HASH=
LOCAL_LOGIN_ROLE=member
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_webhook_secret_token

# Web Config (local Docker). Vercel uses /api/backend through vercel.json service
# routing; never use NEXT_PUBLIC_ variables for database/storage credentials.
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_AUTH_MODE=dev
PORT=3000
