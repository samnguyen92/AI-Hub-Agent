# Vercel + Supabase deployment template
# Copy each NAME=VALUE pair into Vercel > Project > Settings > Environment Variables.
# Do not upload this template as a secret store. Replace every <...> value first.
# Use Production only initially. Add Preview after creating an isolated preview database/bucket.

# Web: same-origin API route served by the API service in the root vercel.json.
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_AUTH_MODE=strict

# API and worker database. Copy the Transaction Pooler host and username from
# Supabase > Connect > Transaction pooler (port 6543). Do not use the direct
# db.<project-ref>.supabase.co:5432 URL for Vercel serverless services.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<URL_ENCODED_DATABASE_PASSWORD>@<TRANSACTION_POOLER_HOST>:6543/postgres?ssl=require

# Supabase project and private Storage bucket. The project URL below is based on
# the project ref already present in your local .env; verify it in Supabase.
SUPABASE_URL=https://vuohmohvisgqgefyygbc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<PASTE_SERVER_ONLY_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=hub-workspaces
WORKSPACE_ARCHIVE_MAX_BYTES=41943040

# Production runtime and authentication. Generate unique random values for both
# secrets. Use the same SANDBOX_SHARED_SECRET for API, sandbox, and worker.
ENVIRONMENT=production
AUTH_MODE=strict
AUTH_SECRET_KEY=<GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
ADMIN_API_TOKEN=<GENERATE_LONG_RANDOM_TOKEN>
SANDBOX_SHARED_SECRET=<GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>

# LLM provider
OPENROUTER_API_KEY=<PASTE_OPENROUTER_API_KEY>

# Vercel worker calls the public sandbox route; replace with the production domain.
SANDBOX_URL=https://ai-hub-agent-web-one.vercel.app/internal/sandbox
WORKSPACES_ROOT=/tmp/hub-workspaces

# Keep the current local email/password login. Copy the existing password HASH
# from your private .env; do not put the plaintext password here.
LOCAL_LOGIN_EMAIL=dev@align.vn
LOCAL_LOGIN_PASSWORD_HASH=<COPY_EXISTING_PBKDF2_HASH_FROM_PRIVATE_ENV>
LOCAL_LOGIN_ROLE=admin

# Google OAuth is optional when local email/password login is used. To enable it,
# set AUTH_MODE and NEXT_PUBLIC_AUTH_MODE to google and enter these Google values.
# GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
# GOOGLE_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
# GOOGLE_ALLOWED_EMAILS=samnguyen4992@gmail.com,dev@align.vn
# GOOGLE_ADMIN_EMAILS=samnguyen4992@gmail.com,dev@align.vn
# GOOGLE_REDIRECT_URI=https://ai-hub-agent-web-one.vercel.app/api/backend/auth/google/callback
# GOOGLE_FRONTEND_URL=https://ai-hub-agent-web-one.vercel.app

# Vercel injects these private service-binding variables; do not create them:
# INTERNAL_API_URL
# SANDBOX_INTERNAL_URL
