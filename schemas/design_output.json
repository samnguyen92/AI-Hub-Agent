{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignOutput",
  "type": "object",
  "properties": {
    "artifact_name": {
      "type": "string",
      "description": "Tên định danh artifact (vd: homepage-mockup)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Số phiên bản (v1, v2,...)"
    },
    "design_tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "typography": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["colors", "typography"],
      "description": "Bộ design tokens trích xuất hoặc áp dụng"
    },
    "html_file_path": {
      "type": "string",
      "description": "Đường dẫn file HTML mockup trong workspace"
    },
    "html_file_url": {
      "type": "string",
      "description": "URL mở trang entry HTML"
    },
    "page_file_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Danh sách các trang HTML riêng có thể mở trong workspace"
    },
    "page_file_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["path", "url"],
        "additionalProperties": false
      }
    },
    "sitemap_file_path": {
      "type": "string",
      "description": "Đường dẫn sitemap.html có liên kết tới các trang"
    },
    "sitemap_file_url": {
      "type": "string",
      "description": "URL mở sitemap HTML"
    },
    "sitemap_xml_path": {
      "type": ["string", "null"],
      "description": "Đường dẫn sitemap.xml nếu canonical site URL đã được cung cấp"
    },
    "zip_file_path": {
      "type": "string",
      "description": "Đường dẫn ZIP chứa HTML và các asset local đã chọn"
    },
    "zip_download_url": {
      "type": "string",
      "description": "URL tải ZIP trong project workspace"
    },
    "screenshots": {
      "type": "object",
      "properties": {
        "desktop_png": { "type": "string" },
        "mobile_png": { "type": "string" }
      },
      "description": "Đường dẫn file ảnh PNG đã render"
    },
    "references_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference_id": { "type": "string" },
          "source_url": { "type": "string" },
          "observations": { "type": "array", "items": { "type": "string" } },
          "adaptations": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["source_url", "observations", "adaptations"],
        "additionalProperties": false
      }
    },
    "motion_spec": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": { "type": "string", "enum": ["css_transition", "css_keyframes", "javascript_runtime", "visual_animation", "webgl_glsl"] },
          "element": { "type": "string" },
          "trigger": { "type": "string" },
          "properties": { "type": "array", "items": { "type": "string" } },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "easing": { "type": "string" },
          "reduced_motion": { "type": "string" },
          "runtime_fallback": { "type": "string" },
          "performance_budget": { "type": "string" }
        },
        "required": ["family", "element", "trigger", "properties", "duration_ms", "easing", "reduced_motion", "runtime_fallback", "performance_budget"],
        "additionalProperties": false
      }
    },
    "changes_summary": {
      "type": "string",
      "description": "Tóm tắt các chi tiết đã thiết kế hoặc thay đổi so với phiên bản trước"
    },
    "review_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "warning"] },
          "note": { "type": "string" }
        },
        "required": ["item", "status"]
      }
    }
  },
  "required": ["artifact_name", "version", "design_tokens", "html_file_path", "html_file_url", "page_file_paths", "page_file_urls", "sitemap_file_path", "sitemap_file_url", "zip_file_path", "zip_download_url", "changes_summary"],
  "additionalProperties": false
}
