{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditFindings",
  "type": "object",
  "properties": {
    "audit_type": {
      "type": "string",
      "enum": ["seo", "technical", "performance"],
      "description": "Loại kiểm định"
    },
    "target_url": {
      "type": "string",
      "format": "uri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "affected_url": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" },
          "suggested_patch": { "type": "string" }
        },
        "required": ["id", "title", "severity", "evidence", "recommendation"]
      }
    },
    "summary": {
      "type": "string",
      "description": "Tóm lược toàn cảnh hiện trạng và thứ tự ưu tiên xử lý"
    }
  },
  "required": ["audit_type", "target_url", "timestamp", "issues", "summary"],
  "additionalProperties": false
}
