FROM python:3.11-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY packages/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY packages/api/app ./app
COPY agents ./agents
COPY skills ./skills
ENV PYTHONPATH=/app WORKSPACES_ROOT=/tmp/hub-workspaces VERCEL_API_PREFIX=/api/backend ENVIRONMENT=production PYTHONUNBUFFERED=1
EXPOSE 80
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
