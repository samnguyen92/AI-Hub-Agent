# Production Environment Configuration for Align AI Hub on Hostinger VPS
# Đổi tên file này thành .env trên VPS (hoặc copy sang .env) và điền các khóa bí mật

# 1. Database Configuration (Chạy trực tiếp trong container Postgres nội bộ)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_db_password
POSTGRES_DB=hub_ai_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_secure_db_password@postgres:5432/hub_ai_agent

# 2. LLM Gateway (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_MODEL=openai/gpt-6-luna
OPENROUTER_VISION_MODEL=openai/gpt-6-luna

# 3. Core App Config
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
SANDBOX_URL=http://sandbox:8001
WORKSPACES_ROOT=/workspaces
CORS_ORIGINS=*

# 4. Security & Authentication (Tạo các chuỗi ngẫu nhiên dài >= 32 ký tự)
AUTH_MODE=strict
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_chars
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
SANDBOX_SHARED_SECRET=replace_with_a_random_sandbox_secret_at_least_32_chars

# 5. Local Login Credentials (Đăng nhập quản trị viên)
LOCAL_LOGIN_EMAIL=dev@align.vn
LOCAL_LOGIN_PASSWORD_HASH=pbkdf2_sha256:600000:YWxpZ25fc2FsdF9zZWN1cmVfMjAyNg:1Gh12TC_xms-eXI-7NA6tM2LuVkgfAj_lTf8S0r87WA
LOCAL_LOGIN_ROLE=admin

# 6. Web Frontend Settings
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_AUTH_MODE=strict
INTERNAL_API_URL=http://api:8000
PORT=3100

# 7. WordPress Multi-tenant Wildcard Routing
WP_BASE_DOMAIN=demo.alignvn.cloud

# 7. Optional Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PAGESPEED_API_KEY=
