FROM python:3.11-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY packages/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY packages/api/app ./app
COPY agents ./agents
COPY skills ./skills
ENV PYTHONPATH=/app WORKSPACES_ROOT=/tmp/hub-workspaces AIHUB_VERCEL_DAEMON=1 ENVIRONMENT=production PYTHONUNBUFFERED=1
CMD ["python", "-m", "app.worker"]
